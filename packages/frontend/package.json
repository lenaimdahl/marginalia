{
  "name": "marginalia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:types": "json2ts -i ../../api/models -o src/types/generated --cwd ../../api/models",
    "generate:api-client": "swagger-typescript-api generate --path ../../api/openapi.yaml --output src/api/generated --name generated.ts --axios"
  },
  "dependencies": {
    "axios": "1.13.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "json-schema-to-typescript": "15.0.4",
    "oxlint": "1.75.0",
    "swagger-typescript-api": "13.2.13",
    "typescript": "6.0.2",
    "vite": "8.2.0"
  }
}
